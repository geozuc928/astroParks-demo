# AstroParks Demo — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env   (macOS/Linux)
#   copy .env.example .env  (Windows)

# PostgreSQL connection string
# Format: postgres://USERNAME:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/astroparks

# Port the web server listens on (default: 3000)
PORT=3000

# Session secret — use a long random string in production
SESSION_SECRET=change-me-to-a-long-random-string

# Stripe API keys — get these from https://dashboard.stripe.com/apikeys
# Use test keys (sk_test_... / pk_test_...) during development
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
